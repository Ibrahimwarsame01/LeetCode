class Solution {
public:
    int miceAndCheese(vector<int>& reward1, vector<int>& reward2, int k) {
        int sum = 0;
        for(int i = 0; i < reward2.size(); i++){
            sum += reward2[i];
        }
        priority_queue<int> maxHeap;
        for(int i = 0; i < reward1.size(); i++){
            maxHeap.push((reward1[i] - reward2[i]));
        }
       
        for(int j = 0; j < k; j++){
            sum += maxHeap.top();
            maxHeap.pop();
        }
        return sum;  
    }
};
